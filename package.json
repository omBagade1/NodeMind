{
  "name": "nodemind",
  "version": "1.0.0",
  "description": "A local, autonomous AI Developer Agent built with Node.js, Express, and Ollama",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "cli": "node --env-file-if-exists=.env src/cli.js",
    "test": "node --env-file-if-exists=.env tests/agent.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omBagade1/NodeMind.git"
  },
  "keywords": [
    "ai-agent",
    "agent",
    "ollama",
    "llama3.2",
    "developer-agent",
    "react-agent",
    "nodejs"
  ],
  "author": "Om Bagade <ombagade951@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/omBagade1/NodeMind/issues"
  },
  "homepage": "https://github.com/omBagade1/NodeMind#readme",
  "type": "module",
  "dependencies": {
    "express": "^5.3.0",
    "ollama": "^0.6.4"
  }
}
